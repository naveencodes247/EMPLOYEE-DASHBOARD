# WorkSphere Portal - Supabase Environment Variables
# Copy this file to .env.local and populate with your project credentials.
# NEVER commit real credentials or the service_role key.

# Supabase Project URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Publishable / Anon Key (Safe for browser clients)
VITE_SUPABASE_ANON_KEY="your-publishable-or-anon-key"

# Next.js compatibility format
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
